FROM python:3.11-slim

WORKDIR /app

# Install build dependencies and WeasyPrint libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .
RUN touch .env

ENV PYTHONPATH=/app

# Make startup script executable inside the container
RUN chmod +x ./start.sh

EXPOSE 8000

# Execute start.sh to run both Celery worker and Uvicorn
CMD ["./start.sh"]